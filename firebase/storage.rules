rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /rooms/{roomId}/{userId}/{harvestId} {
      function room() { return firestore.get(/databases/(default)/documents/rooms/$(roomId)).data; }
      function member() { return request.auth != null && request.auth.uid in room().memberIds; }
      function registered() { return firestore.exists(/databases/(default)/documents/rooms/$(roomId)/harvests/$(harvestId)); }
      allow read: if member();
      allow create: if member() && request.auth.uid == userId && room().phase == 'collecting'
        && !registered() && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if member() && request.auth.uid == userId && !registered();
      allow update: if false;
    }
  }
}
