# Copy to .env.local and fill with the WEB app configuration from Firebase.
# These are public client settings. Never add Admin/service-account private keys.
EXPO_PUBLIC_FIREBASE_ENABLED=false
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Local tests only: use a demo-* project ID and your computer's LAN IP on a phone.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
